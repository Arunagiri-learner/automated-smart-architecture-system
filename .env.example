# ============================================================
# AUTOMATED SMART ARCHITECTURE SYSTEM (ASAS)
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================================

# ------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel / Netlify / Vite)
# ------------------------------------------------------------
VITE_API_BASE_URL=https://your-asas-backend.onrender.com/api

# ------------------------------------------------------------
# BACKEND CONFIGURATION (Render / Railway / Node.js)
# ------------------------------------------------------------
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://username:password@cluster.mongodb.net/asas_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/asas_db?retryWrites=true&w=majority

# Frontend Origin for Production CORS
# Example: https://your-asas-frontend.vercel.app
CLIENT_URL=https://your-asas-frontend.vercel.app

# Optional Upload Storage Directory
UPLOAD_PATH=./uploads
